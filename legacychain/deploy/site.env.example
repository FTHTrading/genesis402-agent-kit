# Per-site settings. Never commit the filled-in copy (site.env is git-ignored).
LC_PASSPHRASE=
LC_STORAGE_KEY=
# The other two validators.
LC_PEERS=https://london.chain.legacychain.app,https://alaska.chain.legacychain.app
LC_PUBLIC_URL=https://hq.chain.legacychain.app
# Bridge site only: x402 facilitator that settles USDC on Base, and its auth header value.
LC_FACILITATOR_URL=
LC_FACILITATOR_AUTH=
LC_BASE_RPC=https://mainnet.base.org
# Cloudflare Zero Trust -> Networks -> Tunnels -> Create -> token.
# Public hostname: <site>.chain.legacychain.app -> http://node:7402
CLOUDFLARE_TUNNEL_TOKEN=
